#!/usr/bin/env bash
# shellcheck disable=SC2088
#
# install all files to ~ by symlinking them,
# this way, updating them is as simple as git pull
#
# Author: Dave Eddy <dave@daveeddy.com>
# Date: May 25, 2012
# License: MIT

trap EXIT true

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)   

# makes "defaults" command print to screen
defaults() {
	echo defaults "$@"
	command defaults "$@"
}

# verbose ln, because `ln -v` is not portable
symlink() {
	printf '%55s -> %s\n' "${1/#$HOME/\~}" "${2/#$HOME/\~}"
	ln -nsf "$@"
}

git submodule init
git submodule update

# Link dotfiles
dotfiles=(
	bash_completion
	bash_profile
	bashrc
	htoprc
	screenrc
	tmux.conf
	vimrc
	vim
)
# i've become famous - whoops. because of this, people like to install my
# dotfiles without customizing them so then they get my git config and "become"
# me and it's super annoying.  so, hide my own git config behind `-f` and i'll
# just handle that myself.
if [[ $1 == '-f' ]]; then
	dotfiles+=(gitconfig)
fi

for f in "${dotfiles[@]}"; do
	[[ -d ~/.$f && ! -L ~/.$f ]] && rm -r ~/."$f"
	symlink "$PWD/$f" ~/."$f"
done

# Setup bics
if [[ ! -d ~/.bics ]]; then
	echo 'installing bics'
	bash <(curl -sSL https://raw.githubusercontent.com/bahamas10/bics/master/bics) init
	rm -r ~/.bics/plugins
	symlink "$PWD/bics-plugins" ~/.bics/plugins
fi

# Keyboard shortcuts for Mac OS X
if [[ -d ~/Library ]]; then
	echo 'installing mac keyboard shourtcuts'
	mkdir -p ~/Library/KeyBindings
	symlink "$PWD/DefaultKeyBinding.dict" ~/Library/KeyBindings/DefaultKeyBinding.dict
fi

if [[ -t 1 ]]; then
	set -x
	vim '+PlugInstall --sync' +qa
	vim '+PlugUpdate --sync' +qa
	set +x
else
	echo 'you may need to run:'
	echo "    vim +'PlugInstall --sync' +qa"
	echo "    vim +'PlugUpdate --sync' +qa"
fi

# Install My (Glenn's) Custom changes
MY_BASH_DIR="~/.config/bash"

if [[ ! -d "MY_BASH_DIR" ]]; then
	echo -e "bash_files (Glenn's additional file) is already installed at $MY_BASH_DIR"
	printf "Do you want to overwrite it? [y|N]: "
	read -r OVERWRITE
	if [[ "${OVERWRITE,,}" = "y" ]]; then
		TIMESTAMP=$(date +%Y%m%d%H%M)
		BACKUP_DST="${SCRIPT_DIR}/.backup/bash_files_${TIMESTAMP}"
		mv "$MY_BASH_DIR" "$BACKUP_DST"
	else
		exit 0
	fi
fi

[[ -d ${MY_BASH_DIR} ]] || git clone https://github.com/gdellis/bash_files.git "$MY_BASH_DIR"

